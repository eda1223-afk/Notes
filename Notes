<body>

  <h1>Not Defterim</h1>

  <div class="add-note">
    <textarea id="noteInput" placeholder="Buraya yeni notunu yaz..."></textarea>
    <button class="btn-add" onclick="addNote()">
      <i class="fas fa-plus"></i> Not Ekle
    </button>
  </div>

  <div class="notes" id="notesContainer">
    <!-- Notlar buraya eklenecek -->
  </div>

<script>
const notesContainer = document.getElementById('notesContainer');
const noteInput = document.getElementById('noteInput');

// Tüm notları yükle
function loadNotes() {
  const notes = JSON.parse(localStorage.getItem('myNotes') || '[]');
  notesContainer.innerHTML = notes.length === 0 
    ? '<p class="empty">Henüz not eklenmemiş.<br>Yukarıya yazıp "Not Ekle" butonuna basarak başlayabilirsin</p>'
    : '';
  
  notes.reverse().forEach((note, index) => {
    createNoteElement(note.text, note.date, notes.length - 1 - index);
  });
}

// Yeni not ekle
function addNote() {
  const text = noteInput.value.trim();
  if (text === '') return alert('Lütfen bir şeyler yaz!');
  
  const notes = JSON.parse(localStorage.getItem('myNotes') || '[]');
  const newNote = {
    text: text,
    date: new Date().toLocaleString('tr-TR')
  };
  notes.push(newNote);
  localStorage.setItem('myNotes', JSON.stringify(notes));
  
  noteInput.value = '';
  loadNotes();
}

// Not kartı oluştur
function createNoteElement(text, date, realIndex) {
  const div = document.createElement('div');
  div.className = 'note';
  div.innerHTML = `
    <div class="note-text">${text.replace(/\n/g, '<br>')}</div>
    <div class="note-date">${date}</div>
    <div class="note-actions">
      <button class="btn-edit" onclick="editNote(${realIndex})">Düzenle</button>
      <button class="btn-delete" onclick="deleteNote(${realIndex})">Sil</button>
    </div>
  `;
  notesContainer.insertBefore(div, notesContainer.firstChild);
}

// Notu sil
function deleteNote(index) {
  if (confirm('Bu notu silmek istediğine emin misin?')) {
    const notes = JSON.parse(localStorage.getItem('myNotes') || '[]');
    notes.splice(index, 1);
    localStorage.setItem('myNotes', JSON.stringify(notes));
    loadNotes();
  }
}

// Notu düzenle
function editNote(index) {
  const notes = JSON.parse(localStorage.getItem('myNotes') || '[]');
  const newText = prompt('Notu düzenle:', notes[index].text);
  if (newText !== null) {
    notes[index].text = newText.trim() || '[boş not]';
    notes[index].date = new Date().toLocaleString('tr-TR') + ' (düzenlendi)';
    localStorage.setItem('myNotes', JSON.stringify(notes));
    loadNotes();
  }
}

// Sayfa yüklendiğinde notları göster
loadNotes();
</script>

</body>
